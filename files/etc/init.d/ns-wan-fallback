# Watches the DHCP client of the WAN and brings the static fallback address (192.168.0.2/24) up when there is no lease.

START=99
STOP=1

USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/sbin/ns-wan-fallback
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param respawn 300 30 10
    procd_close_instance
}

stop_service() {
    ifdown wan_fallback >/dev/null 2>&1
}
